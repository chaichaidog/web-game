# ============================================================
# NOVA Protocol — 失落基地 環境變數範例檔 (.env.example)
# 複製為 .env 後依環境調整，切勿將真實資料庫密碼或金鑰提交至 Git
# ============================================================

# 1. 後端資料庫連線 (Render PostgreSQL 或本機 PostgreSQL)
# 正式環境範例：postgresql+psycopg2://user:password@host:5432/nova_protocol
# 若本機未設定 DATABASE_URL 且 USE_EMBEDDED_PG=true，系統會自動啟動內建的使用者空間 PostgreSQL (pgserver)
DATABASE_URL=
USE_EMBEDDED_PG=true
PG_DATA_DIR=/tmp/nova_protocol_pgdata

# 2. 後端安全與教師端授權設定
SECRET_KEY=replace-with-secure-random-key-in-production
TEACHER_PASSKEY=NOVA-TEACHER-2026

# 3. 允許的跨域來源 (CORS Origins，以逗號分隔)
# 正式環境請填入 Render Static Site 的 HTTPS 網域
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 4. 安全執行引擎限制參數
MAX_INSTRUCTIONS=200
MAX_LOOP_ITERATIONS=100
MAX_EXECUTION_STEPS=500
MAX_NESTING_DEPTH=6

# 5. 前端建置環境變數 (供 Render Static Site 使用)
# 正式環境請填寫 Render Web Service 的 HTTPS 與 WSS 網址
VITE_API_URL=
VITE_WS_URL=

